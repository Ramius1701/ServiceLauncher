{
  "ListenPort": 8090,
  "TokenFile": "token.txt",
  "LogFile": "launcher.log",

  "Volumes": [
    {
      "Id": "servers",
      "DriveLetter": "S",
      "VhdxPath": "D:\\PATH\\TO\\YOUR\\Servers.vhdx"
    }
  ],

  "Services": [
    {
      "Id": "grid_core",
      "DisplayName": "OpenSim Robust (EDIT ME - paths below are placeholders)",
      "RequiresVolume": "servers",
      "ExePath": "S:\\PATH\\TO\\YOUR\\OpenSim\\Robust.exe",
      "Arguments": "-inifile=Robust.HG.ini -background=true",
      "WorkingDirectory": "S:\\PATH\\TO\\YOUR\\OpenSim",
      "Liveness": { "Type": "http", "Url": "http://127.0.0.1:8003/store" },
      "StartupTimeoutSeconds": 90,
      "AutoRestart": {
        "Enabled": true,
        "RestartAttempts": 3,
        "CrashConfirmSeconds": 10,
        "AttemptDelaySeconds": 15
      },
      "AutoLaunch": [
        { "ServiceId": "region_a", "DelaySeconds": 5 },
        { "ServiceId": "region_b", "DelaySeconds": 10 }
      ]
    },
    {
      "Id": "region_a",
      "DisplayName": "Region A (EDIT ME - paths below are placeholders)",
      "RequiresVolume": "servers",
      "ExePath": "S:\\PATH\\TO\\YOUR\\OpenSim\\OpenSim.exe",
      "Arguments": "-inifile=Simulators\\RegionA\\OpenSim.ini -background=true",
      "WorkingDirectory": "S:\\PATH\\TO\\YOUR\\OpenSim",
      "Liveness": { "Type": "http", "Url": "http://127.0.0.1:9000/" },
      "StartupTimeoutSeconds": 60
    },
    {
      "Id": "region_b",
      "DisplayName": "Region B (EDIT ME - paths below are placeholders)",
      "RequiresVolume": "servers",
      "ExePath": "S:\\PATH\\TO\\YOUR\\OpenSim\\OpenSim.exe",
      "Arguments": "-inifile=Simulators\\RegionB\\OpenSim.ini -background=true",
      "WorkingDirectory": "S:\\PATH\\TO\\YOUR\\OpenSim",
      "Liveness": { "Type": "http", "Url": "http://127.0.0.1:9001/" },
      "StartupTimeoutSeconds": 60
    },

    {
      "Id": "majorbbs",
      "DisplayName": "MajorBBS (EDIT ME - paths below are placeholders)",
      "RequiresVolume": "servers",
      "ExePath": "S:\\PATH\\TO\\YOUR\\wgsappgo.exe",
      "Arguments": "",
      "WorkingDirectory": "S:\\PATH\\TO\\YOUR\\BBS\\FOLDER",
      "Liveness": {
        "Type": "process",
        "ProcessPath": "S:\\PATH\\TO\\YOUR\\wgsappgo.exe"
      },
      "StartupTimeoutSeconds": 60
    }
  ],

  "RegionDiscovery": {
    "Enabled": false,
    "SimulatorsDirectory": "S:\\PATH\\TO\\YOUR\\OpenSim\\Simulators",
    "ExePath": "S:\\PATH\\TO\\YOUR\\OpenSim\\OpenSim.exe",
    "WorkingDirectory": "S:\\PATH\\TO\\YOUR\\OpenSim",
    "RequiresVolume": "servers",
    "StartupTimeoutSeconds": 60
  }
}
