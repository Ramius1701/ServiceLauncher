<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ServiceLauncher</RootNamespace>
    <AssemblyName>ServiceLauncher</AssemblyName>
    <Version>0.1.0</Version>

    <!-- Runs both headless (Task Scheduler, no interactive session - GUI
         is skipped, see Program.cs's Environment.UserInteractive check)
         and as a GUI when launched manually at the machine. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <!-- Deployed to C:\ServiceLauncher, deliberately outside any VHDX-
         backed drive, so it can start at boot before that volume is
         mounted - see README.md. Self-contained + single-file so the
         deployed copy has zero dependency on a separately-installed
         .NET runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
